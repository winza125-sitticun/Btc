# Environment
APP_ENV=development
TRADING_MODE=SIMULATION
DIRECT_AI_ORDER_ENABLED=false
ORDER_INTENT_DRY_RUN_ENABLED=false

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Analysis V1 runtime (server-side only)
AI_ANALYSIS_V1_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_ANALYSIS_CANDIDATE_LIMIT=3
AI_ANALYSIS_CONCURRENCY=2
AI_MIN_OPPORTUNITY_SCORE=65

# AI provider-specific variables reserved for later settings/auth milestones
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Multi-Agent Trading Intelligence rollout (server-side only, fail-closed)
AI_MULTI_AGENT_ENABLED=false
AI_MULTI_AGENT_MODE=OFF
AI_MULTI_AGENT_MIN_VALID_ROLES=4
AI_MULTI_AGENT_MIN_COVERAGE=0.67
AI_MULTI_AGENT_MIN_AGREEMENT=0.60
AI_MULTI_AGENT_MIN_SIGNED_SCORE=0.25

# Per-role assignments. Provider/model values are intentionally blank by default.
AI_ROLE_TECHNICAL_ENABLED=false
AI_ROLE_TECHNICAL_PROVIDER=
AI_ROLE_TECHNICAL_MODEL=
AI_ROLE_TECHNICAL_BASE_WEIGHT=1.0
AI_ROLE_TECHNICAL_PROMPT_VERSION=v1
AI_ROLE_MOMENTUM_ENABLED=false
AI_ROLE_MOMENTUM_PROVIDER=
AI_ROLE_MOMENTUM_MODEL=
AI_ROLE_MOMENTUM_BASE_WEIGHT=1.0
AI_ROLE_MOMENTUM_PROMPT_VERSION=v1
AI_ROLE_ORDER_FLOW_ENABLED=false
AI_ROLE_ORDER_FLOW_PROVIDER=
AI_ROLE_ORDER_FLOW_MODEL=
AI_ROLE_ORDER_FLOW_BASE_WEIGHT=1.0
AI_ROLE_ORDER_FLOW_PROMPT_VERSION=v1
AI_ROLE_NEWS_ENABLED=false
AI_ROLE_NEWS_PROVIDER=
AI_ROLE_NEWS_MODEL=
AI_ROLE_NEWS_BASE_WEIGHT=1.0
AI_ROLE_NEWS_PROMPT_VERSION=v1
AI_ROLE_CONTRARIAN_ENABLED=false
AI_ROLE_CONTRARIAN_PROVIDER=
AI_ROLE_CONTRARIAN_MODEL=
AI_ROLE_CONTRARIAN_BASE_WEIGHT=1.0
AI_ROLE_CONTRARIAN_PROMPT_VERSION=v1
AI_ROLE_RISK_REVIEW_ENABLED=false
AI_ROLE_RISK_REVIEW_PROVIDER=
AI_ROLE_RISK_REVIEW_MODEL=
AI_ROLE_RISK_REVIEW_BASE_WEIGHT=1.0
AI_ROLE_RISK_REVIEW_PROMPT_VERSION=v1

# Binance - leave empty during foundation/simulation milestone
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Read-only Binance market scanner (no API key required)
SCANNER_TIMEFRAME=15m
SCANNER_UNIVERSE_LIMIT=30
SCANNER_CANDIDATE_LIMIT=10
SCANNER_CONCURRENCY=5

# Realtime scanner worker (server-side)
MARKET_WORKER_MODE=realtime
SCANNER_INTERVAL_SECONDS=300
REALTIME_SYMBOL_LIMIT=10
REALTIME_FLUSH_SECONDS=3
WORKER_RETRY_SECONDS=10
NEWS_ENRICHMENT_V1_ENABLED=false
WEB_ORIGINS=*

# News intelligence worker (server-side, deterministic Phase 5A)
NEWS_POLL_SECONDS=120
NEWS_HTTP_TIMEOUT_SECONDS=10
NEWS_FETCH_CONCURRENCY=4

# Isolated strategy worker (simulation only; all disabled by default)
STRATEGY_WORKER_ENABLED=false
OUTCOME_EVALUATION_ENABLED=false
SIMULATION_ENGINE_ENABLED=false
STRATEGY_CYCLE_SECONDS=60
SIM_TARGET_RISK_PERCENT=0.5
SIM_TAKER_FEE_BPS=5
SIM_SLIPPAGE_BPS=2
SIM_ENTRY_VALIDITY_MINUTES_15M=60
LIVE_ORDER_EXECUTION_ENABLED=false

# Material strategy alerts (disabled by default; simulation only)
ALERTS_V1_ENABLED=false
ALERT_CHANNELS=IN_APP
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
ALERT_WEBHOOK_URL=

# Readiness evaluation (evidence only; never enables live orders)
READINESS_V1_ENABLED=false

# Web build
VITE_API_BASE_URL=
