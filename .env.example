# Environment
APP_ENV=development
TRADING_MODE=SIMULATION
DIRECT_AI_ORDER_ENABLED=false

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers - configure only providers you use
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Binance - leave empty during foundation/simulation milestone
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Read-only Binance market scanner (no API key required)
SCANNER_TIMEFRAME=15m
SCANNER_UNIVERSE_LIMIT=30
SCANNER_CANDIDATE_LIMIT=10
SCANNER_CONCURRENCY=5
