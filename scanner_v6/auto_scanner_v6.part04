                "price": price,
                "chg": chg,
                "funding": funding,
                "r4": r4,
                "r1": r1,
                "r15": r15,
                "rsi": rsi1,
                "adx": adx1,
                "tags": tags,
                "plan": plan,
                "setup_score": setup_score_result,
                "data_provider": provider_name,
                "shadow_snapshot_id": shadow_snapshot_id,
                "shadow_inserted": shadow_inserted,
                "rez_result": rez_result,
                "rez_event_id": None if rez_record is None else rez_record.event_id,
            }
        )

    if REZ_ANALYSIS_ENABLED:
        print(
            f"[*] REZ: pass={rez_counts['pass']} wait={rez_counts['wait']} "
            f"reject={rez_counts['reject']} expired={rez_counts['expired']} "
            f"promoted={rez_counts['promoted']}"
        )

    print(f"\n[*] Setup Score Gate Passed (>= {SETUP_MIN_SCORE}): {len(qualified_setups)} setups.")
    print("-" * 120)
    print("{:<6} {:<10} {:<12} {:<16} {:<16} {:<8} {:<8} {:<10}".format(
        "Side", "Symbol", "Entry", "Stop Loss", "TP1", "RSI", "ADX", "Funding%"
    ))
    print("-" * 120)

    curr_t = time.time()
    for item in qualified_setups:
        p = item["plan"]
        rsi_val = f"{item['rsi']:.1f}" if item["rsi"] is not None else "N/A"
        sl_sign = "-" if item["side"] == "LONG" else "+"
        tp_sign = "+" if item["side"] == "LONG" else "-"
        sl_str = f"{format_price(p['sl'])} ({sl_sign}{p['sl_pct']:.1f}%)"
        tp1_str = f"{format_price(p['tp1'])} ({tp_sign}{p['tp1_pct']:.1f}%)"

        print("{:<6} {:<10} {:<12} {:<16} {:<16} {:<8} {:<8.1f} {:<+10.4f}".format(
            item["side"], item["symbol"], format_price(p["entry"]), sl_str, tp1_str,
            rsi_val, item["adx"], item["funding"]
        ))

        key = f"{item['symbol']}_{item['side']}"
        if curr_t - recent_signals.get(key, 0) <= ALERT_COOLDOWN_SECONDS:
            if item.get("shadow_inserted"):
                shadow_store.update_decision(
                    item["shadow_snapshot_id"], astra_verdict=None, astra_confidence=None,
                    final_decision="WAIT_COOLDOWN", alert_sent=False,
                )
            continue

        print(f"\n  🧠 Requesting Devil's Advocate AI review for #{item['symbol']}...")
        ai_res = analyze_with_ai(
            item["symbol"], item["side"], p["entry"], item["r4"], item["r1"], item["r15"],
            item["rsi"] if item["rsi"] is not None else 50.0,
            item["adx"], item["funding"], btc_bias, item["tags"], item["plan"], item["setup_score"],
            rez_result=item.get("rez_result"),
        )
        print(f"     -> Astra Confidence: {ai_res.get('confidence', 0)}% | Verdict: {ai_res.get('verdict', 'REJECT')}")

        if not ai_decision_is_approved(ai_res, AI_MIN_CONFIDENCE):
            verdict = ai_res.get("verdict", "REJECT")
            print(f"     [x] Astra {verdict}/fail-closed: {ai_res.get('risk', 'unknown risk')}")
            if item.get("shadow_inserted"):
                final_state = "WAIT_ASTRA" if str(verdict).upper() == "WAIT" else "REJECT_ASTRA"
                shadow_store.update_decision(
                    item["shadow_snapshot_id"],
                    astra_verdict=str(verdict).upper(),
                    astra_confidence=ai_res.get("confidence"),
                    final_decision=final_state,
                    alert_sent=False,
                )
            continue

        icon = "🟢 *[STRUCTURE LONG]*" if item["side"] == "LONG" else "🔴 *[STRUCTURE SHORT]*"
        target_lines = [
            f"💰 *TP1:* `{format_price(p['tp1'])}` ({tp_sign}{p['tp1_pct']:.2f}% | R:R 1:{p['rr_tp1']:.2f})"
        ]
        if p.get("tp2") is not None:
            target_lines.append(
                f"🚀 *TP2:* `{format_price(p['tp2'])}` ({tp_sign}{p['tp2_pct']:.2f}% | R:R 1:{p['rr_tp2']:.2f})"
            )
        if p.get("tp3") is not None:
            target_lines.append(
                f"🏁 *TP3:* `{format_price(p['tp3'])}` ({tp_sign}{p['tp3_pct']:.2f}% | R:R 1:{p['rr_tp3']:.2f})"
            )
        targets_text = "\n".join(target_lines)
        score = item["setup_score"]
        comp = score["components"]
        rez_context_text = ""
        item_rez = item.get("rez_result")
        if item_rez is not None:
            trigger_parts = [str(item_rez.trigger_15m)]
            trigger_parts.extend(sorted(str(value) for value in item_rez.supporting_triggers))
            trigger_text = " + ".join(trigger_parts)
            rez_context_text = (
                f"📐 *1H Structure:* `{item_rez.structure_1h}`\n"
                f"⚡ *15m Trigger:* `{trigger_text}`\n"
                f"🧪 *Analysis:* `{item_rez.analysis_version}`\n"
            )
        msg = (
            f"{icon} `#{item['symbol']}`\n"
            f"━━━━━━━━━━━━━━━━━━━\n"
            f"🧠 *Setup Score:* `{score['score']}/100`\n"
            f"Trend `{comp['trend']}/20` | Strength `{comp['strength']}/15` | Structure `{comp['structure']}/30`\n"
            f"Market `{comp['market']}/15` | Funding `{comp['funding']}/10` | Timing `{comp['timing']}/10`\n"
            f"🤖 *Astra:* `APPROVED` | *Confidence:* `{ai_res['confidence']}%`\n"
            f"✅ *Final Decision:* `{item['side']}`\n"
            f"{rez_context_text}"
            f"💡 *เหตุผล:* {ai_res.get('reason', '')}\n"
            f"⚠️ *จุดเสี่ยง:* {ai_res.get('risk', '')}\n"
            f"━━━━━━━━━━━━━━━━━━━\n"
            f"👑 *BTC Bias:* `{btc_bias}` | *ADX:* `{item['adx']:.1f}`\n"
            f"🛰 *Market Data:* `{item['data_provider']}` | *Signal:* `TradingView BINANCE`\n"
            f"🎯 *Entry:* `{format_price(p['entry'])}`\n"
            f"🛑 *Stop Loss:* `{format_price(p['sl'])}` ({sl_sign}{p['sl_pct']:.2f}%)\n"
            f"🧱 *Structure Stop:* `{format_price(p['structure_stop'])}` | *ATR:* `{format_price(p['atr'])}`\n"
            f"{targets_text}\n"
            f"━━━━━━━━━━━━━━━━━━━\n"
            f"📊 *Trend:* 4H=`{item['r4']}` / 1H=`{item['r1']}` / 15m=`{item['r15']}` | *RSI:* `{rsi_val}`\n"
            f"💡 *Invalidation:* {p['invalidation']}"
        )

        alert_sent = send_telegram_alert(msg)
        if item.get("shadow_inserted"):
            shadow_store.update_decision(
                item["shadow_snapshot_id"],
                astra_verdict="APPROVED",
                astra_confidence=ai_res.get("confidence"),
                final_decision=item["side"],
                alert_sent=alert_sent,
            )
        if alert_sent:
            recent_signals[key] = curr_t
            print(f"🔥 [ALERT SENT] -> #{item['symbol']}")
        else:
            print(f"[x] Alert delivery failed; cooldown not started for #{item['symbol']}")

    print("-" * 120)
    return recent_signals


_structure_trade_plan_core = build_structure_trade_plan


def _classify_structure_reject_reason(
    side,
    entry_price,
    candles_1h,
    candles_4h=None,
    pivot_levels=None,
    min_rr=1.5,
    atr_period=14,
    atr_buffer_mult=0.25,
    swing_window=2,
):
    """Classify why the unchanged structure core returned None; telemetry only."""
    try:
        side = str(side).upper()
        if side not in {"LONG", "SHORT"} or entry_price is None or entry_price <= 0:
            return "INVALID_INPUT"
        if min_rr <= 0 or atr_buffer_mult < 0:
            return "INVALID_PARAMETERS"

        candles_4h = candles_4h or []
        pivot_levels = pivot_levels or []
        atr = calculate_atr(candles_1h, period=atr_period)
        if atr is None or atr <= 0:
            return "ATR_INVALID"

        swings_1h = find_confirmed_swings(candles_1h, window=swing_window)
        swings_4h = (
            find_confirmed_swings(candles_4h, window=swing_window)
            if candles_4h else {"highs": [], "lows": []}
        )
        buffer_dist = atr * atr_buffer_mult

        if side == "LONG":
            stop_candidates = [s for s in swings_1h["lows"] if s["price"] < entry_price]
            if not stop_candidates:
                return "NO_PROTECTED_SWING"
            structure_stop = stop_candidates[-1]["price"]
            sl = structure_stop - buffer_dist
            if sl >= entry_price:
                return "SL_INVALID"
            target_levels = [s["price"] for s in swings_1h["highs"] if s["price"] > entry_price]
            target_levels += [s["price"] for s in swings_4h["highs"] if s["price"] > entry_price]
            target_levels += [float(v) for v in pivot_levels if v is not None and float(v) > entry_price]
        else:
            stop_candidates = [s for s in swings_1h["highs"] if s["price"] > entry_price]
            if not stop_candidates:
                return "NO_PROTECTED_SWING"
            structure_stop = stop_candidates[-1]["price"]
            sl = structure_stop + buffer_dist
            if sl <= entry_price:
                return "SL_INVALID"
            target_levels = [s["price"] for s in swings_1h["lows"] if s["price"] < entry_price]
            target_levels += [s["price"] for s in swings_4h["lows"] if s["price"] < entry_price]
            target_levels += [float(v) for v in pivot_levels if v is not None and float(v) < entry_price]

        risk_dist = abs(entry_price - sl)
        if risk_dist <= 0:
            return "RISK_INVALID"

        tolerance = max(entry_price * 0.0001, atr * 0.05)
        targets = _dedupe_levels(target_levels, tolerance)
        if side == "SHORT":
            targets = list(reversed(targets))
        if not targets:
            return "NO_TARGET"

        rr_tp1 = abs(targets[0] - entry_price) / risk_dist
        if rr_tp1 < min_rr:
            return "RR_TOO_LOW"
        return "UNKNOWN_STRUCTURE_REJECT"
    except Exception:
        return "DIAGNOSTIC_ERROR"


def build_structure_trade_plan(
    side,
    entry_price,
    candles_1h,
    candles_4h=None,
    pivot_levels=None,
    min_rr=1.5,
    atr_period=14,
    atr_buffer_mult=0.25,
    swing_window=2,
    diagnostics=None,
):
    """Call the unchanged structure core and attach observation-only diagnostics."""
    result = _structure_trade_plan_core(
        side=side,
        entry_price=entry_price,
        candles_1h=candles_1h,
        candles_4h=candles_4h,
        pivot_levels=pivot_levels,
        min_rr=min_rr,
        atr_period=atr_period,
        atr_buffer_mult=atr_buffer_mult,
        swing_window=swing_window,
    )
    if result is None and diagnostics is not None:
        diagnostics["reason"] = _classify_structure_reject_reason(
            side=side,
            entry_price=entry_price,
            candles_1h=candles_1h,
            candles_4h=candles_4h,
            pivot_levels=pivot_levels,
            min_rr=min_rr,
            atr_period=atr_period,
            atr_buffer_mult=atr_buffer_mult,
            swing_window=swing_window,
        )
    return result


_run_scan_cycle_without_telemetry = run_scan_cycle


def run_scan_cycle(limit: int = 40, recent_signals: Optional[Dict[str, float]] = None):
    """Run one legacy scan cycle and emit observation-only funnel counters."""
    counters = {
        "universe": 0,
        "tv_ready": 0,
        "aligned": 0,
        "filters_passed": 0,
        "structure_passed": 0,
        "rez_entered": 0,
        "rez_pass": 0,
        "rez_wait": 0,
        "rez_reject": 0,
        "score_ge_75": 0,
        "astra_called": 0,
        "alerts_sent": 0,
    }
    structure_reject_counts = {}
    score_attempts = 0
    rez_wait_results = 0
    btc_basis_calls = 0

    original_create_market_data_session = create_market_data_session
    original_market_price_basis_ok = market_price_basis_ok
    original_setup_passes_filters = setup_passes_filters
    original_build_structure_trade_plan = build_structure_trade_plan
    original_analyze_rez_candidate = analyze_rez_candidate
    original_score_setup = score_setup
    original_score_passes_threshold = score_passes_threshold
    original_analyze_with_ai = analyze_with_ai
    original_send_telegram_alert = send_telegram_alert

    def counted_create_market_data_session(*args, **kwargs):
        session = original_create_market_data_session(*args, **kwargs)
        if session is not None:
            counters["universe"] = len(list(session.snapshot.symbols))
        return session

    def counted_market_price_basis_ok(session, symbol, *args, **kwargs):
        nonlocal btc_basis_calls
        result = original_market_price_basis_ok(session, symbol, *args, **kwargs)
        if symbol == "BTCUSDT" and btc_basis_calls == 0:
            btc_basis_calls += 1
        else:
            counters["tv_ready"] += 1
            if symbol == "BTCUSDT":
                btc_basis_calls += 1
        return result

    def counted_setup_passes_filters(*args, **kwargs):
        counters["aligned"] += 1
        result = original_setup_passes_filters(*args, **kwargs)
        if result:
            counters["filters_passed"] += 1
        return result

    def counted_build_structure_trade_plan(*args, **kwargs):
        diagnostics = kwargs.get("diagnostics")
        if diagnostics is None:
            diagnostics = {}
            kwargs["diagnostics"] = diagnostics
        result = original_build_structure_trade_plan(*args, **kwargs)
        if result:
            counters["structure_passed"] += 1
        else:
            reason = str(diagnostics.get("reason") or "UNKNOWN_STRUCTURE_REJECT")
            structure_reject_counts[reason] = structure_reject_counts.get(reason, 0) + 1
        return result

    def counted_analyze_rez_candidate(*args, **kwargs):
        nonlocal rez_wait_results
        counters["rez_entered"] += 1
        result = original_analyze_rez_candidate(*args, **kwargs)
        if getattr(result, "state", None) == "WAIT":
            rez_wait_results += 1
        return result

    def counted_score_setup(*args, **kwargs):
        nonlocal score_attempts
        score_attempts += 1
        return original_score_setup(*args, **kwargs)

    def counted_score_passes_threshold(*args, **kwargs):
        result = original_score_passes_threshold(*args, **kwargs)
        if result:
            counters["score_ge_75"] += 1
        return result

    def counted_analyze_with_ai(*args, **kwargs):
        counters["astra_called"] += 1
        return original_analyze_with_ai(*args, **kwargs)

    def counted_send_telegram_alert(*args, **kwargs):
        result = original_send_telegram_alert(*args, **kwargs)
        if result:
            counters["alerts_sent"] += 1
        return result

    globals()["create_market_data_session"] = counted_create_market_data_session
    globals()["market_price_basis_ok"] = counted_market_price_basis_ok
    globals()["setup_passes_filters"] = counted_setup_passes_filters
    globals()["build_structure_trade_plan"] = counted_build_structure_trade_plan
    globals()["analyze_rez_candidate"] = counted_analyze_rez_candidate
    globals()["score_setup"] = counted_score_setup
    globals()["score_passes_threshold"] = counted_score_passes_threshold
    globals()["analyze_with_ai"] = counted_analyze_with_ai
    globals()["send_telegram_alert"] = counted_send_telegram_alert

    try:
        return _run_scan_cycle_without_telemetry(limit=limit, recent_signals=recent_signals)
    finally:
        globals()["create_market_data_session"] = original_create_market_data_session
        globals()["market_price_basis_ok"] = original_market_price_basis_ok
        globals()["setup_passes_filters"] = original_setup_passes_filters
        globals()["build_structure_trade_plan"] = original_build_structure_trade_plan
        globals()["analyze_rez_candidate"] = original_analyze_rez_candidate
        globals()["score_setup"] = original_score_setup
        globals()["score_passes_threshold"] = original_score_passes_threshold
        globals()["analyze_with_ai"] = original_analyze_with_ai
        globals()["send_telegram_alert"] = original_send_telegram_alert

        if REZ_ANALYSIS_ENABLED:
            counters["rez_pass"] = score_attempts
            counters["rez_wait"] = rez_wait_results
            counters["rez_reject"] = max(
                0,
                counters["rez_entered"] - counters["rez_pass"] - counters["rez_wait"],
            )

        if structure_reject_counts:
            reason_summary = " ".join(
                f"{reason}={structure_reject_counts[reason]}"
                for reason in sorted(structure_reject_counts)
            )
            print(f"[*] STRUCTURE_REJECTS: {reason_summary}")

        print(
            "[*] TELEMETRY: "
            f"universe={counters['universe']} "
            f"tv_ready={counters['tv_ready']} "
            f"aligned={counters['aligned']} "
            f"filters_passed={counters['filters_passed']} "
            f"structure_passed={counters['structure_passed']} "
            f"rez_entered={counters['rez_entered']} "
            f"rez_pass={counters['rez_pass']} "
            f"rez_wait={counters['rez_wait']} "
            f"rez_reject={counters['rez_reject']} "
            f"score_ge_75={counters['score_ge_75']} "
            f"astra_called={counters['astra_called']} "
            f"alerts_sent={counters['alerts_sent']}"
        )


def main(interval: int = 5, limit: int = 40):
    print(f"🤖 Analysis Engine V6 Shadow Evaluation started. Scanning every {interval} min(s).")
    print("🔒 Mode: decision-support only; no order execution code is present.")
    signals: Dict[str, float] = {}
    while True:
        try:
            signals = run_scan_cycle(limit=limit, recent_signals=signals)
        except KeyboardInterrupt:
            print("\nStopped by user.")
            break
        except Exception as exc:
            print(f"[x] Scan cycle error (fail-closed): {exc}")
        time.sleep(interval * 60)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Crypto Futures Analysis Engine V6 (shadow evaluation + calibration)")
    parser.add_argument("--interval", type=int, default=5, help="Scan interval in minutes")
    parser.add_argument("--limit", type=int, default=40, help="Number of futures symbols to scan")
    args = parser.parse_args()
    main(interval=args.interval, limit=args.limit)